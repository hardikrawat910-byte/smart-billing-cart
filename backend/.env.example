# ---- MySQL ----
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=smart_billing
# Online MySQL (e.g. Aiven) needs an encrypted connection: DB_SSL=1.
# Optional: DB_SSL_CA=C:/SmartCart/ca.pem (path to the CA file) also verifies the server.
DB_SSL=0
DB_SSL_CA=

# ---- Security ----
JWT_SECRET=
# The Raspberry Pi sends this value in the X-Device-Key header (put the same in pi/cart_agent.ini)
DEVICE_KEY=
# Wrong passwords allowed per email before a 15-minute lock
LOGIN_MAX_FAILURES=5
LOGIN_LOCK_MINUTES=15

# ---- Google sign-in (optional) ----
# Google Cloud console > APIs & Services > Credentials > OAuth client ID (Web application).
# Authorised JavaScript origins: http://localhost:5000 and your https site. Blank = no Google button.
GOOGLE_CLIENT_ID=
# Google accounts that become admins when they sign in (comma separated)
ADMIN_GOOGLE_EMAILS=

# ---- First admin account (created by seed.py) ----
# Blank = seed.py makes up a random password and prints it once.
ADMIN_EMAIL=admin@smartcart.local
ADMIN_PASSWORD=

# ---- Item verification ----
# Starting value only: the admin can switch it on the website (Admin > Hardware).
# off    = software only (QR/barcode lookup)       <- safe demo fallback
# weight = barcode + load-cell weight must agree
# full   = barcode + weight + camera colour must agree
HARDWARE_MODE=off
WEIGHT_TOLERANCE_PCT=5
MIN_ITEM_WEIGHT_G=2
READING_MAX_AGE_SEC=15
COLOR_MAX_DISTANCE=70

# ---- SmartCart Wallet ----
# Demo money for every new account (0 = customers top up at the counter with a token)
WALLET_WELCOME_AMOUNT=0
WALLET_MAX_TOPUP=10000
# The shop's UPI ID: top-up tokens get a "Pay with a UPI app" button and the counter shows a UPI QR
# with the amount filled in. Blank = cash/UPI at the counter as before.
UPI_ID=
UPI_PAYEE_NAME=SmartCart

# ---- Item-not-scanned alert ----
# Weight placed on the cart that no scan uses within this many seconds -> alert (scan page, admin, Pi buzzer)
UNSCANNED_ALERT_SEC=15
# Shop time zone for the admin dashboard's "today" (minutes from UTC; India = 330)
APP_UTC_OFFSET_MINUTES=330

# ---- Memory cache ----
# Products are kept in the server's memory; re-read from MySQL at most this often (seconds)
PRODUCT_CACHE_SECONDS=300

# ---- Server ----
# 1 = auto-reload + error debugger (only on your own PC). Keep 0 when the site is online.
FLASK_DEBUG=0
